#include <windows.h>
101 ICON "resources/nigh.ico"
1 VERSIONINFO
 FILEVERSION 0,1,0,0
 PRODUCTVERSION 0,1,0,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS 0x40004L
 FILETYPE 0x1L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "041604B0"
        BEGIN
            VALUE "FileDescription", "Nigh Editor"
            VALUE "FileVersion", "0.1.0"
            VALUE "InternalName", "NighEditor"
            VALUE "OriginalFilename", "NighEditor.exe"
            VALUE "ProductName", "Nigh Editor"
            VALUE "ProductVersion", "0.1.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0416, 1200
    END
END
